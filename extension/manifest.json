{
  "manifest_version": 3,
  "name": "WatchTogether Cinema Companion",
  "version": "1.0.0",
  "description": "Companion extension for WatchTogether: Capture browser movie tabs in real time with high quality and synchronized audio.",
  "permissions": [
    "tabCapture",
    "tabs",
    "activeTab",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WatchTogether Cinema Companion"
  }
}
